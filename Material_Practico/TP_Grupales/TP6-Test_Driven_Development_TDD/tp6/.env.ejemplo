# Copiar este archivo como ".env" (no se sube a git) y completar los datos.
# Sin .env la app funciona igual, pero el mail de confirmacion se simula.

# Cuenta de Gmail que envia los mails de confirmacion.
SMTP_HOST=smtp.gmail.com
SMTP_PUERTO=587
SMTP_USUARIO=tu.cuenta@gmail.com
# Contrasena de aplicacion de Google (16 letras), NO la clave normal.
SMTP_CLAVE=
# Opcional: nombre que ve el destinatario.
SMTP_REMITENTE=EcoHarmony Park <tu.cuenta@gmail.com>

# Casilla que recibe el mail de la prueba manual (pytest -m smtp_real).
SMTP_DESTINO_PRUEBAS=danogamer987654321@gmail.com
